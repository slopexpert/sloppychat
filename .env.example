# Copy to .env and adjust. SvelteKit does not load this file by itself,
# export the values or pass them to the process instead.

# Production server
PORT=3000
HOST=0.0.0.0
# Set when the app runs behind a proxy, for example https://chat.example.com
ORIGIN=

# Store location, default is ./var/sloppychat.db
SLOPPYCHAT_DATA_DIR=./var
# SLOPPYCHAT_DB=/absolute/path/to/sloppychat.db

# Door key for every device. Unset means the server answers 127.0.0.1 and ::1 only.
# In a container it is required, because no request arrives from loopback.
# Make one with: openssl rand -hex 24
SLOPPYCHAT_TOKEN=
